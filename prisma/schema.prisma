generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  PUBLIC
  ADMIN
}

enum AppointmentActivityType {
  CREATED
  RESCHEDULED
  CANCELLED
}

enum AvailabilityExceptionType {
  AVAILABLE
  UNAVAILABLE
}

enum AuditActorType {
  ADMIN
  CUSTOMER
}

enum AuditEntityType {
  APPOINTMENT
  CUSTOMER
  SERVICE
  SERVICE_CATEGORY
  WEEKLY_AVAILABILITY
  AVAILABILITY_EXCEPTION
  BOOKING_SETTINGS
  AGENDA_SETTINGS
}

enum EmailKind {
  BOOKING_CONFIRMATION
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
  APPOINTMENT_REMINDER
  DAILY_DIGEST
}

enum EmailStatus {
  SENT
  FAILED
}

enum AuditActionType {
  CREATED
  UPDATED
  DELETED
  CANCELLED
  RESCHEDULED
  REORDERED
  ARCHIVED
  RESTORED
  FILE_ASSIGNED
  FILE_REMOVED
  ANONYMIZED
  MERGED
}

model ServiceCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  color       String    @default("#d99086")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]

  @@index([isActive, sortOrder])
  @@map("service_category")
}

model Service {
  id                 String           @id @default(cuid())
  slug               String           @unique
  agendaSourceId     Int?             @unique
  categoryId         String?
  name               String
  description        String?
  preparationAdvice  String?
  contraindications  String?
  expectedResults    String?
  aftercareAdvice    String?
  faqQuestion1       String?
  faqAnswer1         String?
  faqQuestion2       String?
  faqAnswer2         String?
  faqQuestion3       String?
  faqAnswer3         String?
  priceNote          String?
  durationMinutes    Int
  preparationMinutes Int              @default(0)
  cleanupMinutes     Int              @default(0)
  priceCents         Int
  color              String           @default("#d99086")
  imageUrl           String?
  consentFormUrl     String?
  sortOrder          Int              @default(0)
  isBookable         Boolean          @default(true)
  isVisible          Boolean          @default(true)
  isArchived         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  category           ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  appointments       Appointment[]

  @@index([categoryId, isArchived, sortOrder])
  @@index([isBookable, isVisible, isArchived])
  @@map("service")
}

model WeeklyAvailability {
  id          String   @id @default(cuid())
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dayOfWeek, startMinute, endMinute])
  @@index([dayOfWeek, startMinute])
  @@map("weekly_availability")
}

model AvailabilityException {
  id        String                    @id @default(cuid())
  groupId   String                    @default(cuid())
  type      AvailabilityExceptionType
  startsAt  DateTime
  endsAt    DateTime
  label     String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([startsAt, endsAt, type])
  @@index([groupId, startsAt])
  @@map("availability_exception")
}

model BookingSettings {
  id                        String   @id @default("default")
  minBookingNoticeHours     Int      @default(12)
  bookingHorizonMonths      Int      @default(3)
  customerChangeCutoffHours Int      @default(48)
  slotIntervalMinutes       Int      @default(15)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("booking_settings")
}

/// Affichage de l'agenda, partagé par toutes les personnes qui l'ouvrent.
///
/// Le choix vivait dans le `localStorage` du navigateur : Arzu et Noé ne
/// voyaient donc pas la même semaine. Une ligne unique en base suffit — il n'y a
/// qu'un institut, et qu'un agenda.
model AgendaSettings {
  id          String   @id @default("default")
  visibleDays Int[]    @default([1, 2, 3, 4, 5, 6, 0])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("agenda_settings")
}

model Customer {
  id String @id @default(cuid())
  /// Reste écrit à la création, le temps que la version précédente du site
  /// quitte la production : elle cherche encore ses fiches par ce condensé.
  /// La migration de retrait est décrite dans docs/data-operations.md.
  identityDigest String @unique
  /// Incrémenté par le trigger `customer_identity_version_trigger` dès qu'une
  /// adresse change ou que les coordonnées sont effacées : les sessions
  /// ouvertes cessent alors d'être valides.
  identityVersion Int     @default(1)
  firstName       String?
  lastName        String
  email           String
  /// Clé d'identité depuis la v2 : une adresse, une personne. L'index unique
  /// qui le garantit arrive avec la migration de retrait des condensés, une
  /// fois cette version en production.
  emailNormalized String
  phone           String
  phoneNormalized String
  searchName      String
  firstSeenAt     DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  anonymizedAt    DateTime?
  internalNote    String?
  preferences     String?
  appointments    Appointment[]

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([searchName])
  @@index([anonymizedAt])
  @@map("customer")
}

model Appointment {
  id                      String                @id @default(cuid())
  serviceId               String
  customerId              String?
  serviceNameSnapshot     String
  servicePriceCents       Int
  serviceDurationMinutes  Int
  preparationMinutes      Int                   @default(0)
  cleanupMinutes          Int                   @default(0)
  startsAt                DateTime
  endsAt                  DateTime
  // timestamptz est imposé par la contrainte d'exclusion GIST
  // `appointment_no_confirmed_overlap`, qui s'appuie sur tstzrange().
  occupiedStartsAt        DateTime              @db.Timestamptz(3)
  occupiedEndsAt          DateTime              @db.Timestamptz(3)
  customerFirstName       String?
  customerLastName        String
  customerSearchName      String
  customerEmail           String?
  customerPhone           String?
  /// Plus jamais écrites : conservées le temps d'une version, puis retirées
  /// (voir docs/data-operations.md). Aucune requête ne les lit.
  customerIdentityDigest  String?
  customerIdentityVersion Int                   @default(1)
  comment                 String?
  source                  AppointmentSource
  status                  AppointmentStatus     @default(CONFIRMED)
  cancelledAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  service                 Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer                Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  activities              AppointmentActivity[]
  emailDeliveries         EmailDelivery[]

  @@index([startsAt, endsAt, status])
  @@index([occupiedStartsAt, occupiedEndsAt, status])
  @@index([customerEmail, customerPhone, startsAt])
  @@index([customerPhone, startsAt])
  @@index([customerSearchName, startsAt])
  @@index([customerSearchName(ops: raw("gin_trgm_ops"))], map: "appointment_customerSearchName_trgm_idx", type: Gin)
  @@index([customerIdentityDigest, startsAt, status])
  @@index([customerId, startsAt, status])
  @@index([serviceId, startsAt])
  @@index([status, source, startsAt])
  @@map("appointment")
}

model AppointmentActivity {
  id                          String                  @id @default(cuid())
  type                        AppointmentActivityType
  appointmentId               String?
  customerFirstNameSnapshot   String?
  customerLastNameSnapshot    String
  serviceNameSnapshot         String
  appointmentStartsAt         DateTime
  previousAppointmentStartsAt DateTime?
  readAt                      DateTime?
  createdAt                   DateTime                @default(now())
  appointment                 Appointment?            @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([readAt, createdAt])
  @@index([appointmentId, createdAt])
  @@map("appointment_activity")
}

model AuditEvent {
  id          String          @id @default(cuid())
  actorType   AuditActorType
  actorId     String
  entityType  AuditEntityType
  entityId    String
  entityLabel String?
  action      AuditActionType
  changes     Json?
  createdAt   DateTime        @default(now())

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([actorType, createdAt])
  @@map("audit_event")
}

/// Trace de chaque e-mail transactionnel.
///
/// L'envoi est volontairement secondaire : le rendez-vous est déjà enregistré
/// quand la ligne est écrite. Seul le strict nécessaire au renvoi est conservé
/// — destinataire, objet, et le rendez-vous d'origine — le corps du message
/// étant reconstruit à la demande plutôt que dupliqué ici.
model EmailDelivery {
  id            String       @id @default(cuid())
  kind          EmailKind
  status        EmailStatus
  recipient     String
  subject       String
  appointmentId String?
  providerId    String?
  error         String?
  attempts      Int          @default(1)
  sentAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([appointmentId, createdAt])
  @@map("email_delivery")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  keyHash     String
  action      String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([keyHash, action, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_bucket")
}
