# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local PostgreSQL (`pnpm db:up`). Neon injects its own values on Vercel.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/arbeaute"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5434/arbeaute"

# Simple administration authentication
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET="" # Generate with: openssl rand -base64 32
CUSTOMER_SESSION_SECRET="" # Generate with: openssl rand -base64 32

# Vercel Blob public store (automatically injected by Vercel)
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""

# E-mails transactionnels (Resend). Sans ces variables, aucun e-mail n'est
# envoyé et l'application fonctionne normalement.
RESEND_API_KEY=""
RESEND_FROM="Arbeauté <rendez-vous@arbeaute-bulle.ch>"
ADMIN_NOTIFICATION_EMAIL="" # destinataire du bilan destiné à Arzu

# Aucune tâche planifiée n'existe : les rappels et le récapitulatif quotidiens
# ont été supprimés. `CRON_SECRET` reviendra avec le bilan hebdomadaire —
# Vercel ne l'injecte de toute façon que lorsqu'un cron est déclaré dans
# vercel.json.
