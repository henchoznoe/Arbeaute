# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local PostgreSQL (`pnpm db:up`). Neon injects its own values on Vercel.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/arbeaute"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5434/arbeaute"

# Simple administration authentication
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET="" # Generate with: openssl rand -base64 32
CUSTOMER_SESSION_SECRET="" # Generate with: openssl rand -base64 32

# Vercel Blob public store (automatically injected by Vercel)
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
